# Copy to .env and fill in TOKEN.

# Discord bot token (required)
TOKEN=

# Absolute or relative path to the JSON config file (default: config.json)
TUTELAR_CONFIG=config.json

# Where per-guild state is persisted (default: var/state.json)
TUTELAR_STATE_PATH=var/state.json

# Bot owner Discord user id (unlocks owner-only commands)
OWNER_ID=
